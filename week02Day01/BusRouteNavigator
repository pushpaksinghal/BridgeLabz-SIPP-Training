Class Ticket
    Attributes:
        movieName
        seatNumber
        price
        bookingStatus

    Constructor(movieName, seatNumber, price):
        Set attributes
        bookingStatus = "Booked"

    Method cancel():
        bookingStatus = "Cancelled"


Class Theatre
    Attributes:
        movieSchedules
        availableSeats
        tickets

    Method issueTicket(movieName, seatNumber, price):
        If seatNumber in availableSeats[movieName]:
            Create new Ticket(movieName, seatNumber, price)
            Add ticket to tickets
            Remove seatNumber from availableSeats[movieName]
            Print "Ticket booked successfully."
            Return ticket
        Else:
            Print "Seat not available."
            Return null

    Method cancelTicket(ticket):
        If ticket in tickets AND ticket.bookingStatus == "Booked":
            ticket.cancel()
            Add ticket.seatNumber back to availableSeats[ticket.movieName]
            Print "Ticket cancelled successfully."
        Else:
            Print "Invalid cancellation request."


Class Customer
    Attributes:
        name
        bookedTickets

    Constructor(name):
        Set name
        bookedTickets = empty list

    Method browseMovies(theatre):
        Print theatre.movieSchedules

    Method bookTicket(theatre, movieName, seatNumber, price):
        ticket = theatre.issueTicket(movieName, seatNumber, price)
        If ticket is not null:
            Add ticket to bookedTickets

    Method cancelTicket(theatre, ticket):
        theatre.cancelTicket(ticket)
        Remove ticket from bookedTickets


