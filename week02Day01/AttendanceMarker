Class AttendanceTracker
    Attributes:
        attendance[students][days]

    Constructor(numStudents, numDays):
        Create 2D array attendance[numStudents][numDays]
        Initialize all cells with 'A'

    Method markAttendance(studentID, day, status):
        attendance[studentID][day] = status

    Method updateAttendance(studentID, day, newStatus):
        attendance[studentID][day] = newStatus

    Method generateReport(studentID):
        count = 0
        For day from 1 to numDays:
            If attendance[studentID][day] == 'P':
                count = count + 1
        Print "Student " + studentID + " was present " + count + " days."

    Method displayAttendance(studentID):
        Print "Attendance of Student " + studentID + ": "
        For day from 1 to numDays:
            Print attendance[studentID][day] + " "
        Print new line


Main Program:
    numStudents = 3
    numDays = 30
    tracker = AttendanceTracker(numStudents, numDays)

    tracker.markAttendance(1, 1, 'P')
    tracker.markAttendance(1, 2, 'P')
    tracker.markAttendance(1, 3, 'A')
    tracker.markAttendance(1, 4, 'P')
    tracker.markAttendance(1, 5, 'P')
    tracker.markAttendance(1, 6, 'P')
    tracker.markAttendance(1, 7, 'A')

    tracker.displayAttendance(1)

    tracker.updateAttendance(1, 3, 'P')

    tracker.displayAttendance(1)

    tracker.generateReport(1)
