Class DailyTasksOrganizer
    Attributes:
        tasks
        taskCounter
    Constructor():
        Initialize tasks as empty LinkedHashMap
        taskCounter = 0

    Method addTask(description):
        taskCounter = taskCounter + 1
        tasks.put(taskCounter, description)
        Print "Task " + taskCounter + " added: " + description

    Method removeTask(taskID):
        If tasks contains taskID:
            tasks.remove(taskID)
            Print "Task " + taskID + " removed."
        Else:
            Print "Task " + taskID + " not found."

    Method viewTasks():
        Print "Pending Tasks:"
        For each (id, description) in tasks (in insertion order):
            Print id + " → " + description


Main Program:
    organizer = DailyTasksOrganizer()

    organizer.addTask("Check emails")
    organizer.addTask("Prepare sales report")
    organizer.addTask("Call client")

    organizer.viewTasks()

    organizer.removeTask(2)

    organizer.viewTasks()
